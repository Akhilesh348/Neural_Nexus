{
  "rule_version": "1.1.0",
  "notes": "Weights are engineering choices, not evidence-backed laws. An email is flagged for review only if at least one strong language rule fires on the sender's own (authored) text or subject. Communication and timing signals only add points to already-flagged emails.",

  "language": {
    "points_per_strong_rule": 30,
    "cap": 60,
    "context_window_chars": 250,
    "context_exclusions": [
      "intended recipient", "in error", "notify (?:me|us|the sender)", "contact the sender",
      "reply (?:e-?mail|to the sender)", "privileged", "including (?:any )?attachments",
      "number listed above", "unauthorized", "prohibited",
      "deleted items", "unsubscribe", "mailbox (?:size|limit|quota|is full)", "disk space",
      "storage limit", "(?:outlook|notes) migration", "remove you from",
      "virus", "feel free to delete", "no longer (?:of interest|wish)",
      "respondent", "survey", "this link"
    ],
    "news_suppression": {
      "id": "N-NEWS",
      "explanation": "Not evaluated: text looks like a press article or newsletter, not the sender's own words",
      "markers": [
        "all rights reserved", "\\(c\\) ?(?:copyright|\\d{4})", "copyright \\d{4}", "\\u00a9",
        "dow jones", "reuters", "associated press", "new york times", "wall street journal",
        "washington post", "los angeles times", "houston chronicle", "financial times", "bloomberg",
        "business wire", "pr newswire", "todaysheadlines", "unsubscribe", "newsletter", "click here",
        "cnn\\b", "\\bAP\\b -", "staff writer"
      ],
      "min_markers": 2,
      "single_marker_min_chars": 1500
    },
    "negation_window_chars": 25,
    "negation_pattern": "\\b(?:not|don'?t|never|shouldn'?t|won'?t|can'?t|no need to)\\b",
    "strong_rules": [
      {
        "id": "K-DESTROY",
        "explanation": "Asks for records, files or emails to be destroyed or deleted",
        "check_negation": true,
        "patterns": [
          "\\bshred(?:s|ded|ding)? (?:[\\w-]+ ){0,3}?(?:documents?|files?|records?|papers?|e-?mails?|evidence|copies|everything)\\b",
          "\\bdestroy(?:ed|ing)? (?:[\\w-]+ ){0,3}?(?:documents?|files?|records?|e-?mails?|papers?|copies|notes|evidence)\\b",
          "\\bdelete (?:this|these|the|that|those|all|any|my|your) (?:e-?mails?|messages?|files?|documents?|notes?|records?)\\b",
          "\\bget rid of (?:the|these|those|any|all|your) (?:documents?|files?|records?|e-?mails?|papers?)\\b",
          "\\bpurge (?:the|these|those|all|your) (?:documents?|files?|records?|e-?mails?)\\b"
        ]
      },
      {
        "id": "K-SECRECY",
        "explanation": "Asks the recipient to keep the content secret or not to pass it on",
        "patterns": [
          "\\bkeep (?:this|it|that) (?:quiet|under wraps|to yourself|between (?:us|you and me|ourselves))\\b",
          "\\bbetween you and me\\b",
          "\\b(?:do not|don'?t|please don'?t) (?:forward|share|repeat|distribute|mention) (?:this|it)\\b",
          "\\b(?:do not|don'?t) tell anyone\\b",
          "\\boff the record\\b",
          "\\boff the books\\b",
          "\\beyes only\\b"
        ]
      },
      {
        "id": "K-NO-RECORD",
        "explanation": "Suggests avoiding a written record of the discussion",
        "patterns": [
          "\\b(?:do not|don'?t|never) put (?:this|it|that|anything) in writing\\b",
          "\\bkeep (?:this|it) off (?:e-?mail|paper)\\b",
          "\\b(?:do not|don'?t) (?:e-?mail|write) (?:this|me about this)\\b",
          "\\bno paper trail\\b",
          "\\bavoid (?:creating )?(?:a )?(?:paper trail|written record|record of)\\b",
          "\\b(?:call me|discuss (?:this )?(?:by|over the) phone) rather than (?:e-?mail|writing)\\b"
        ]
      }
    ],
    "topic_rule": {
      "id": "K-TOPIC",
      "explanation": "Mentions a special-purpose entity named in the public Powers Report (context only)",
      "points": 10,
      "patterns": ["\\bLJM\\d?\\b", "\\bRaptors?\\b", "\\bChewco\\b", "\\bJEDI\\b", "\\bWhitewing\\b"]
    }
  },

  "communication": {
    "cap": 30,
    "internal_domains": ["enron.com"],
    "external": {
      "id": "C-EXTERNAL",
      "points": 15,
      "explanation": "Sent from Enron to at least one address outside the internal domain list"
    },
    "rare_pair": {
      "id": "C-RARE-PAIR",
      "points": 15,
      "max_pair_emails": 2,
      "min_sender_emails": 20,
      "explanation": "Sender (20+ emails) rarely writes to this recipient (at most 2 emails in the corpus)"
    }
  },

  "timing": {
    "weekend": {
      "id": "T-WEEKEND",
      "points": 10,
      "explanation": "Sent on a Saturday or Sunday (by header date, US/Pacific)"
    },
    "hour_rule": {
      "id": "T-OFF-HOURS",
      "status": "not_evaluated",
      "explanation": "Not evaluated: header hours are not the sender's local time (all headers are -0700/-0800 and run ~3 h from in-body Lotus timestamps; 28% of emails fall in 22:00-05:59)"
    }
  },

  "priority_bands": {"high": 60, "medium": 30},
  "people": {"min_sent_emails": 10}
}
