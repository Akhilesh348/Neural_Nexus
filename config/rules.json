{
  "rule_version": "1.3.0",
  "notes": "Weights are engineering choices, not evidence-backed laws. An email is flagged for review only if at least one language rule fires on the sender's own (authored) text or subject. Each phrase has a strength (strong 40 / medium 25 / weak 15); each rule contributes its strongest hit. Communication, topic and timing signals only add points to already-flagged emails.",

  "language": {
    "cap": 60,
    "context_window_chars": 250,
    "context_exclusions": [
      "intended recipient", "in error", "notify (?:me|us|the sender)", "contact the sender",
      "reply (?:e-?mail|to the sender)", "privileged", "including (?:any )?attachments",
      "number listed above", "unauthorized", "prohibited",
      "deleted items", "unsubscribe", "mailbox (?:size|limit|quota|is full)", "disk space",
      "storage limit", "(?:outlook|notes) migration", "remove you from",
      "virus", "feel free to delete", "no longer (?:of interest|wish)",
      "respondent", "survey", "this link",
      "workspace", "imported correctly", "windows directory", "format c", "response list",
      "not interested", "file attachment", "grant access",
      "\\bshred of\\b", "between you and me and", "roll(?:s|ed|ing)? off the books"
    ],
    "news_suppression": {
      "id": "N-NEWS",
      "explanation": "Not evaluated: text looks like a press article, newsletter or advertisement, not the sender's own words",
      "markers": [
        "all rights reserved", "\\(c\\) ?(?:copyright|\\d{4})", "copyright \\d{4}", "\\u00a9",
        "dow jones", "reuters", "associated press", "new york times", "wall street journal",
        "washington post", "los angeles times", "houston chronicle", "financial times", "bloomberg",
        "business wire", "pr newswire", "todaysheadlines", "unsubscribe", "newsletter", "click here",
        "cnn\\b", "staff writer", "galleries", "<a href", "class=\"", "width=\"",
        "special offer", "hand ?picked", "elite member"
      ],
      "min_markers": 2,
      "single_marker_min_chars": 1500
    },
    "bulk_sender_suppression": {
      "id": "N-BULK",
      "explanation": "Not evaluated: sender looks like a mailing list, announcement or automated account",
      "sender_patterns": [
        "\\blists?\\.", "newsletter", "announce", "mailer", "wizard", "no-?reply", "\\bdeals?@",
        "promo", "marketing@", "^securepack@", "^microsoft\\."
      ]
    },
    "negation_window_chars": 25,
    "negation_pattern": "\\b(?:not|don'?t|never|shouldn'?t|won'?t|can'?t|no need to)\\b",
    "strong_rules": [
      {
        "id": "K-DESTROY",
        "explanation": "Asks for records, files or emails to be destroyed or deleted",
        "check_negation": true,
        "patterns": [
          {"strength": "strong", "points": 40, "pattern": "\\bshred(?:s|ded|ding)? (?:[\\w-]+ ){0,3}?(?:documents?|files?|records?|papers?|e-?mails?|evidence|copies|everything)\\b"},
          {"strength": "strong", "points": 40, "pattern": "\\bdestroy(?:ed|ing)? (?:[\\w-]+ ){0,3}?(?:documents?|files?|records?|e-?mails?|papers?|copies|notes|evidence)\\b"},
          {"strength": "strong", "points": 40, "pattern": "\\bget rid of (?:the|these|those|any|all|your) (?:documents?|files?|records?|e-?mails?|papers?)\\b"},
          {"strength": "strong", "points": 40, "pattern": "\\bpurge (?:the|these|those|all|your) (?:documents?|files?|records?|e-?mails?)\\b"},
          {"strength": "weak", "points": 15, "pattern": "\\bdelete (?:this|these|the|that|those|all|any|my|your) (?:e-?mails?|messages?|files?|documents?|notes?|records?)\\b"}
        ]
      },
      {
        "id": "K-OFF-BOOKS",
        "explanation": "Talks about keeping something off the books (possible accounting concealment)",
        "patterns": [
          {"strength": "strong", "points": 40, "pattern": "\\boff the books\\b"}
        ]
      },
      {
        "id": "K-NO-RECORD",
        "explanation": "Suggests avoiding a written record of the discussion",
        "patterns": [
          {"strength": "strong", "points": 40, "pattern": "\\b(?:do not|don'?t|never) put (?:this|it|that|anything) in writing\\b"},
          {"strength": "strong", "points": 40, "pattern": "\\bkeep (?:this|it) off (?:e-?mail|paper)\\b"},
          {"strength": "strong", "points": 40, "pattern": "\\b(?:do not|don'?t) (?:e-?mail|write) (?:this|me about this)\\b"},
          {"strength": "strong", "points": 40, "pattern": "\\bno paper trail\\b"},
          {"strength": "strong", "points": 40, "pattern": "\\bavoid (?:creating )?(?:a )?(?:paper trail|written record|record of)\\b"},
          {"strength": "strong", "points": 40, "pattern": "\\b(?:call me|discuss (?:this )?(?:by|over the) phone) rather than (?:e-?mail|writing)\\b"},
          {"strength": "strong", "points": 40, "pattern": "\\b(?:rather not|prefer not to|better not) put (?:this|it|that|anything) in writing\\b"},
          {"strength": "weak", "points": 15, "pattern": "\\b(?:would )?rather (?:discuss|talk about|talk) (?:this |it )?(?:in person|offline|off-line|face to face)\\b"}
        ]
      },
      {
        "id": "K-SECRECY",
        "explanation": "Asks the recipient to keep the content secret or not to pass it on",
        "patterns": [
          {"strength": "medium", "points": 25, "pattern": "\\bkeep (?:this|it|that) (?:quiet|under wraps|to yourself|between (?:us|you and me|ourselves))\\b"},
          {"strength": "medium", "points": 25, "pattern": "\\bbetween you and me\\b"},
          {"strength": "medium", "points": 25, "pattern": "\\b(?:do not|don'?t) tell anyone\\b"},
          {"strength": "medium", "points": 25, "pattern": "\\b(?:do not|don'?t|please don'?t) mention (?:this|it)\\b"},
          {"strength": "medium", "points": 25, "pattern": "\\boff the record\\b"},
          {"strength": "medium", "points": 25, "pattern": "\\bkeep (?:this|it) (?:strictly )?confidential\\b"},
          {"strength": "medium", "points": 25, "pattern": "\\btreat (?:this|it) as (?:strictly )?confidential\\b"},
          {"strength": "medium", "points": 25, "pattern": "\\b(?:do not|don'?t|please don'?t) (?:discuss|share) (?:this |it )?with anyone\\b"},
          {"strength": "weak", "points": 15, "pattern": "\\b(?:do not|don'?t|please don'?t) (?:forward|share|repeat|distribute) (?:this|it)\\b"},
          {"strength": "weak", "points": 15, "pattern": "\\beyes only\\b"}
        ]
      }
    ],
    "topic_rule": {
      "id": "K-TOPIC",
      "explanation": "Mentions a finance-risk or investigation topic (Powers Report entities, SPEs, mark-to-market, auditors, regulators) — context only",
      "points": 10,
      "patterns": [
        "\\bLJM\\d?\\b", "\\bRaptors?\\b", "\\bChewco\\b", "\\bJEDI\\b", "\\bWhitewing\\b", "\\bCondor\\b",
        "\\bspecial purpose (?:entit(?:y|ies)|vehicles?)\\b", "(?-i:\\bSPEs?\\b)", "\\bmark[- ]to[- ]market\\b",
        "\\bprepays?\\b", "\\bAndersen\\b", "(?-i:\\bSEC\\b)", "\\bsubpoena\\w*", "\\brestat(?:e|ed|ement)\\b",
        "\\bwrite[- ]?downs?\\b", "\\boff[- ]balance[- ]sheet\\b",
        "\\bdocument (?:retention|destruction)\\b", "\\bshredding\\b", "\\bcover-?ups?\\b",
        "\\bcook(?:ing)? the books\\b", "\\bmanag(?:e|ing) earnings\\b", "\\bhide the loss(?:es)?\\b"
      ]
    }
  },

  "communication": {
    "cap": 30,
    "internal_domains": ["enron.com"],
    "external": {
      "id": "C-EXTERNAL",
      "points": 10,
      "explanation": "Sent from Enron to at least one address outside the internal domain list"
    },
    "rare_pair": {
      "id": "C-RARE-PAIR",
      "points": 10,
      "max_pair_emails": 2,
      "min_sender_emails": 20,
      "explanation": "Sender (20+ emails) rarely writes to this recipient (at most 2 emails in the corpus)"
    },
    "narrow": {
      "id": "C-NARROW",
      "points": 10,
      "max_recipients": 3,
      "explanation": "Request went to a small audience (1-3 recipients), i.e. a private message rather than a broadcast"
    }
  },

  "timing": {
    "cap": 5,
    "weekend": {
      "id": "T-WEEKEND",
      "points": 5,
      "explanation": "Sent on a Saturday or Sunday (by header date, US/Pacific)"
    },
    "hour_rule": {
      "id": "T-OFF-HOURS",
      "status": "not_evaluated",
      "explanation": "Not evaluated: header hours are not the sender's local time (all headers are -0700/-0800 and run ~3 h from in-body Lotus timestamps; 28% of emails fall in 22:00-05:59)"
    }
  },

  "priority_bands": {"high": 60, "medium": 35},
  "people": {"min_sent_emails": 10}
}
